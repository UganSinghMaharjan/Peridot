# ─────────────────────────────────────────────────────────────
# Peridot by LWE — Environment Variables Example
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
#
# All variables MUST be prefixed with VITE_ to be exposed
# to the browser by Vite.
# ─────────────────────────────────────────────────────────────

# WhatsApp Contact Numbers (include country code, no + sign)
VITE_WHATSAPP_PRIMARY=977XXXXXXXXXX
VITE_WHATSAPP_SECONDARY=977XXXXXXXXXX

# Contact Email
VITE_CONTACT_EMAIL=your-email@example.com

# Social Media URLs
VITE_INSTAGRAM_URL=https://www.instagram.com/your-handle/
VITE_FACEBOOK_URL=https://www.facebook.com/your-page
VITE_TIKTOK_URL=https://www.tiktok.com/@your-handle

# Business Info
VITE_BUSINESS_NAME=Your Brand Name
VITE_BUSINESS_LOCATION=Your City, Your Country
